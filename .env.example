# Configure these privately in Vercel or a gitignored .env.local. Never commit API keys.
RESEND_API_KEY=
QUOTE_TO_EMAIL=

# Optional. Set only after verifying the sending domain in Resend.
# Example: No Pressure Website <hi@nopressure.au>
# Leaving this empty preserves the existing owner-confirmed test sender.
QUOTE_FROM_EMAIL=
